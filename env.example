# Скопіюйте цей файл як .env для локального запуску (vercel dev).
# На хостингу ці змінні додаються в налаштуваннях проєкту (Environment Variables).
# НІКОЛИ не публікуйте реальні значення в GitHub.

# Токен бота від @BotFather (формат 123456789:AAAA...)
TELEGRAM_BOT_TOKEN=

# ID вашої Telegram-групи (для груп зазвичай від'ємне число, напр. -1001234567890)
TELEGRAM_CHAT_ID=

# ID пікселя Meta (лише цифри). Якщо порожньо — піксель не вмикається.
META_PIXEL_ID=

# (необов'язково) Дозволений домен, напр. https://your-domain.com — додатковий захист від чужих запитів
ALLOWED_ORIGIN=
